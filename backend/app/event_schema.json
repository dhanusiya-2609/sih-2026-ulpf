{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ulpf.local/schemas/universal-event/1.0",
  "title": "ULPF Universal Event Schema",
  "description": "Vendor-neutral, schema-versioned representation of a normalized network/security event. Optional fields use null to represent 'unavailable/undetermined', distinct from an explicit empty string, which represents a confirmed empty value in the source data.",
  "type": "object",
  "required": ["event_id", "schema_version", "ingest_timestamp", "source", "event", "network", "normalization", "raw_event"],
  "properties": {
    "event_id": {"type": "string"},
    "schema_version": {"type": "string"},
    "event_timestamp": {"type": ["string", "null"], "description": "ISO 8601 UTC if the original timestamp could be confidently parsed"},
    "event_timestamp_raw": {"type": ["string", "null"], "description": "Original timestamp text as received, preserved verbatim"},
    "timestamp_uncertain": {"type": "boolean"},
    "ingest_timestamp": {"type": "string", "description": "ISO 8601 UTC processing time, always present"},
    "source": {
      "type": "object",
      "properties": {
        "source_id": {"type": ["string", "null"]},
        "device_name": {"type": ["string", "null"]},
        "vendor": {"type": ["string", "null"]},
        "device_type": {"type": ["string", "null"]},
        "source_ip": {"type": ["string", "null"], "description": "Device management/reporting IP, NOT the connection source IP"}
      }
    },
    "event": {
      "type": "object",
      "properties": {
        "category": {"type": ["string", "null"]},
        "type": {"type": ["string", "null"]},
        "action": {"type": ["string", "null"]},
        "severity": {"type": ["string", "null"]},
        "outcome": {"type": ["string", "null"]}
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "transport": {"type": ["string", "null"]},
        "protocol": {"type": ["string", "null"]},
        "source_ip": {"type": ["string", "null"]},
        "source_port": {"type": ["integer", "null"]},
        "destination_ip": {"type": ["string", "null"]},
        "destination_port": {"type": ["integer", "null"]}
      }
    },
    "vendor_fields": {"type": "object", "description": "Preserved fields with no confirmed mapping to the common schema"},
    "message": {"type": ["string", "null"]},
    "normalization": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["success", "partial", "failed", "unrecognized"]},
        "parser_name": {"type": ["string", "null"]},
        "parser_version": {"type": ["string", "null"]},
        "mapping_version": {"type": ["string", "null"]},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "unparsed_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "raw_event": {
      "type": "object",
      "required": ["raw_event_id"],
      "properties": {
        "raw_event_id": {"type": "string"},
        "content_hash": {"type": ["string", "null"]},
        "raw_message": {"type": ["string", "null"]}
      }
    }
  }
}
